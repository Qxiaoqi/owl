JD_ANALYSIS_BASE_URL=https://api.deepseek.com
JD_ANALYSIS_MODEL=deepseek-v4-pro
JD_ANALYSIS_API_KEY=

# DeepSeek higher quality model:
# JD_ANALYSIS_MODEL=deepseek-v4-pro

# OpenRouter example:
# JD_ANALYSIS_BASE_URL=https://openrouter.ai/api/v1
# JD_ANALYSIS_MODEL=deepseek/deepseek-v4-pro
# JD_ANALYSIS_API_KEY=
# JD_ANALYSIS_HTTP_REFERER=http://localhost:3000
# JD_ANALYSIS_APP_TITLE=Owl

JD_ANALYSIS_TIMEOUT_MS=1800000

# Optional. Leave unset to use the provider/model default output limit.
# JD_ANALYSIS_MAX_TOKENS=8192
